{
  "name": "Ubuntu GUI Container (ROS2 Jazzy)",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "BASE_IMAGE": "ros2-jazzy-dev:latest"
    }
  },

  "runArgs": [
    "--net=host",
    "--ipc=host",
    "--device=nvidia.com/gpu=all"
  ],

  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=${localEnv:XDG_RUNTIME_DIR},target=/run/user/1000,type=bind,consistency=cached",
    "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
  ],

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "/run/user/1000",
    "XAUTHORITY": "${localEnv:XAUTHORITY}",
    "QT_QPA_PLATFORM": "xcb",
    "QT_X11_NO_MITSHM": "1",
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:8}",
    "ROS_DISTRO": "jazzy",
    "NVIDIA_VISIBLE_DEVICES": "${localEnv:NVIDIA_VISIBLE_DEVICES:all}",
    "NVIDIA_DRIVER_CAPABILITIES": "${localEnv:NVIDIA_DRIVER_CAPABILITIES:all}",
    "LIBGL_ALWAYS_SOFTWARE": "${localEnv:LIBGL_ALWAYS_SOFTWARE:0}"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": [
              "-c",
              "source /opt/ros/jazzy/setup.bash && [ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash && exec bash"
            ]
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compilerPath": "/usr/bin/g++",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
        "cmake.configureOnOpen": true,
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.formatting.provider": "black",
        "python.linting.enabled": true,
        "python.linting.flake8Enabled": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.colcon_install_layout": true
        }
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "streetsidesoftware.code-spell-checker",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "root",

  "initializeCommand": "bash .devcontainer/detect-gpu.sh || true",

  "forwardPorts": [],

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace"
}
